# Copy to .env.local and fill in your own values.
# .env.local is gitignored — never commit real keys.

# Supabase — Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed for server-side work that bypasses RLS.
# Leave blank unless you specifically need it.
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps — enable Maps JavaScript API + Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. Used server-side for reverse geocoding in
# POST /api/emergencies. Falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_API_KEY=

# Fitbit OAuth — https://dev.fitbit.com/apps
# Only needed if you want the wearable integration.
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=